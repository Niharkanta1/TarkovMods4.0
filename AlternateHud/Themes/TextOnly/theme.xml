<?xml version="1.0" encoding="utf-8"?>
<Theme name="TextOnly">
  <Font name="Bender" shadow="true" />
  <Colors good="#a5dc76" warn="#e8c85a" bad="#df554e" text="#dce1df" dim="#858e8a" highlight="#f2cf5b" lost="#3a2a2a" />
  <Vitals show="true" anchor="TopLeft" x="20" y="-20" scale="1">
    <Silhouette show="false" prefix="body_minimal" image="body_minimal_silhouette.png" outline="none"
                maskMode="luminance" maskThreshold="0.84" maskSoftness="0.12"
                x="0" y="-130" width="86" height="132" opacity="0.94" baseColor="#dce1df24" flash="true" />
    <Stat id="Health" label="HEALTH" showLabel="true" x="0" y="-24" size="20" labelSize="9" color="#a5dc76" barWidth="66" barHeight="0" suffix="/{max}" />
    <Stat id="Energy" label="ENERGY" showLabel="true" x="0" y="-60" size="20" labelSize="9" color="#e8c85a" barWidth="66" barHeight="0" suffix="/{max}" />
    <Stat id="Hydration" label="HYDRATION" showLabel="true" x="0" y="-96" size="20" labelSize="9" color="#64b8d4" barWidth="66" barHeight="0" suffix="/{max}" />
    <Status show="true" x="0" y="-134" size="11" />
  </Vitals>
  <Icons enabled="false" />
  <Effects show="true" anchor="TopLeft" x="20" y="-190" rowHeight="20" fontSize="12" />
  <Equipment show="true" anchor="BottomRight" x="-20" y="128" rowHeight="30" fontSize="14" ammoSize="18" grenadeLabel="GRENADES" />
  <Movement show="true" anchor="BottomLeft" x="20" y="20" fontSize="12" showStanceText="true" showSpeedText="true"
            showStaminaLabels="true" showStaminaIcon="false" stanceY="76" speedY="50"
            staminaY="24" handsStaminaY="0" />
  <HitMarker show="true" style="X" thickness="1" length="5" gap="4" duration="0.25" punch="1.08" color="#ffffff" headshotColor="#f2cf5b" killColor="#d9473d" />
  <DamageNumbers show="true" size="18" life="0.9" rise="55" />
  <DamageDirection show="false" radius="190" length="55" thickness="1" life="1.5" color="#d9473d" />
  <KillFeed show="true" anchor="TopRight" x="-20" y="-120" max="3" life="5" size="14" spacing="2" grow="Down"
            format="{name}  {c:#858e8a}{weapon}  {distance}m  {part}{/c}"
            headshotFormat="{name}  {c:#858e8a}{weapon}  {distance}m{/c}  {c:#f2cf5b}HEADSHOT{/c}" />
</Theme>
