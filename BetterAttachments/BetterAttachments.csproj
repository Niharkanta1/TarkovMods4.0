<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BetterAttachments</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.2.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <!-- The two lines below will set the output path for the binaries -->
    <OutputPath>bin\$(Configuration)\SPT_Runtime\user\mods\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- ZIP -->
    <ZipFileName>BetterAttachments_v$([System.String]::Copy('$(Version)').Replace('.', '-')).zip</ZipFileName>
    <ZipOutputPath>$(MSBuildProjectDirectory)\dist\$(ZipFileName)</ZipOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="config\**\*" CopyToOutputDirectory="Always"/>
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
  </ItemGroup>

  <Target Name="CreateReleaseZip"
        AfterTargets="Build"
        Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ZipSourcePath>$(MSBuildProjectDirectory)\bin\$(Configuration)\SPT_Runtime</ZipSourcePath>
      <ZipOutputPath>$(MSBuildProjectDirectory)\dist\$(ZipFileName)</ZipOutputPath>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\dist" />
    <Message Text="Creating release ZIP: $(ZipOutputPath)" Importance="high" />
    <Delete Files="$(ZipOutputPath)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(ZipSourcePath)' -DestinationPath '$(ZipOutputPath)' -Force&quot;" />
  </Target>

</Project>
